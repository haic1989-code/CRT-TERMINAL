{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRT Terminal",
  "version": "0.1.46",
  "identifier": "com.smartflow.crtterminal",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CRT Terminal",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://tauri.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../mt5-bridge/start.ps1": "mt5-bridge/start.ps1",
      "../mt5-bridge/bridge.py": "mt5-bridge/bridge.py",
      "../mt5-bridge/replay_import_worker.py": "mt5-bridge/replay_import_worker.py",
      "../mt5-bridge/replay_ticks.py": "mt5-bridge/replay_ticks.py",
      "../mt5-bridge/replay_store.py": "mt5-bridge/replay_store.py",
      "../mt5-bridge/replay_worker.py": "mt5-bridge/replay_worker.py",
      "../mt5-bridge/replay_finance.py": "mt5-bridge/replay_finance.py",
      "../mt5-bridge/execution.py": "mt5-bridge/execution.py",
      "../mt5-bridge/quotes.py": "mt5-bridge/quotes.py",
      "../mt5-bridge/CRTMarketSessions.mq5": "mt5-bridge/CRTMarketSessions.mq5",
      "../mt5-bridge/requirements.txt": "mt5-bridge/requirements.txt",
      "../mt5-bridge/wheelhouse/": "mt5-bridge/wheelhouse/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQTRFMzM5M0VBM0I0NDEKUldSQnRLTStPZU9rSUNUZDc3WDB4V2tROGxmT3pneFA5ZXdKWXQzZm9oTEpSNmkzbHp0UXJRbEkK",
      "endpoints": [
        "https://github.com/haic1989-code/CRT-TERMINAL/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
